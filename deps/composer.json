{
    "name": "opotopo/woocommerce-seller-api-deps",
    "description": "Зависимости рантайма модуля WooCommerce до сборки php-scoper",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^8.3",
        "opotopo/seller-api": "^1.3"
    },
    "replace": {
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php82": "*"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
